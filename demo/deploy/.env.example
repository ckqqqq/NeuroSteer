# With a real DNS record pointing to the VPS, Caddy obtains HTTPS automatically.
NEUROSTEER_SITE=demo.example.com
# Without a domain, use http://YOUR_VPS_IP (plain HTTP).
# NEUROSTEER_SITE=http://203.0.113.10
# Optional absolute cache directory on the VPS:
# NEUROSTEER_CACHE_PATH=/srv/neurosteer-caches
